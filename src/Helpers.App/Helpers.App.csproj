<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      The app is shared; only Services/AppPlatform.cs names a platform project.
      On Windows it builds for Windows and takes Helpers.Windows. Anywhere else,
      or with -p:HelpersTarget=other, it builds without it, which proves the
      shared code stands by itself.
    -->
    <HelpersTarget Condition="'$(HelpersTarget)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">windows</HelpersTarget>
    <HelpersTarget Condition="'$(HelpersTarget)' == ''">other</HelpersTarget>
    <TargetFramework Condition="'$(HelpersTarget)' == 'windows'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(HelpersTarget)' != 'windows'">net10.0</TargetFramework>
    <!-- The program is Unmuddle.exe; the code keeps its working title in namespaces. -->
    <AssemblyName>Unmuddle</AssemblyName>
    <RootNamespace>Helpers.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helpers.Core\Helpers.Core.csproj" />
    <ProjectReference Include="..\Helpers.Speech\Helpers.Speech.csproj" />
    <ProjectReference Include="..\Helpers.Ai\Helpers.Ai.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(HelpersTarget)' == 'windows'">
    <ProjectReference Include="..\Helpers.Windows\Helpers.Windows.csproj" />
  </ItemGroup>

  <!--
    LLamaSharp's CPU backend copies native libraries for every platform into the
    output. A publish for one runtime only needs that runtime's folder, so the rest
    (Linux, Mac, ARM: about 80 MB) are left out of the install.
  -->
  <Target Name="DropOtherPlatformNatives" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <!-- The package writes these paths with doubled separators (runtimes\\win-x64\...), so match loosely. -->
      <_OtherPlatformNative Include="@(ResolvedFileToPublish)"
                            Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^runtimes(?>[\\/]+)(?!$(RuntimeIdentifier)[\\/])'))" />
      <ResolvedFileToPublish Remove="@(_OtherPlatformNative)" />
    </ItemGroup>
  </Target>
</Project>
